{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "rm -rf node_modules package-lock.json && npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://gitcompass.onrender.com/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
